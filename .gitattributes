# Line endings and diff behaviour for the Cube Trials repository.
#
# A nested repository keeps its own attributes, so the superproject's
# .gitattributes does not reach in here — this is a local copy of the same
# policy. Godot writes LF; pinning eol=lf keeps a Windows checkout from
# disagreeing with the editor.
#
# Safe as-is: this repository is being populated from a checkout that already
# holds LF, so nothing renormalizes and no mass-rewrite commit is needed.

# Normalize EOL for everything Git detects as text.
* text=auto eol=lf

# Godot source formats, declared explicitly so none is misdetected as binary.
*.gd        text eol=lf
*.tscn      text eol=lf
*.tres      text eol=lf
*.import    text eol=lf
*.uid       text eol=lf
*.md        text eol=lf

# Authored binary assets: never normalize, never diff as text. The game's art
# is generated by tools/capture_art.gd; tools/reference/car.png is a drafting
# aid that must survive byte-for-byte.
*.png       binary
*.webp      binary
*.jpg       binary
*.jpeg      binary
*.wav       binary
*.ogg       binary
*.ogv       binary
*.blend     binary
*.glb       binary
